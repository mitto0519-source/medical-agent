    "last_updated": "2026-05-27",
    "description": "모든 의학 논문 docx 출력의 표준 양식. 깨지지 않도록 절대 변경 금지 (변경 시 version bump)."
  },

  "page": {
    "size": "A4",
    "margins_cm": {"top": 2.54, "bottom": 2.54, "left": 3.0, "right": 2.5}
  },

  "font": {
    "family": "Times New Roman",
    "body_size_pt": 11,
    "title_size_pt": 12,
    "table_size_pt": 9,
    "caption_size_pt": 10,
    "reference_size_pt": 11
  },

  "spacing": {
    "line_spacing_rule": "double",
    "first_line_indent_cm": 1.27,
    "space_before_heading_pt": 12,
    "space_after_heading_pt": 6,
    "paragraph_space_after_pt": 0
  },

  "alignment": {
    "title_page": "center",
    "section_heading": "left",
    "subsection_heading": "left",
    "body": "justify",
    "reference_list": "justify"
  },

  "title_page": {
    "separate_page": true,
    "title_bold": true,
    "title_size_pt": 12,
    "title_alignment": "center",
    "author_alignment": "center",
    "affiliation_alignment": "center",
    "affiliation_size_pt": 11,
    "affiliation_italic": false,
    "superscript_marker": ["a", "b", "c", "d"]
  },

  "abstract": {
    "heading_text": "Abstract",
    "heading_bold": true,
    "heading_size_pt": 11,
    "body_indent": true,
    "body_alignment": "justify",
    "inline_label_bold": true,
    "inline_labels": ["Background", "Methods", "Results", "Conclusion"],
    "label_separator": ": ",
    "keywords_label": "Keywords",
    "keyword_separator": "; "
  },

  "main_sections": {
    "order": ["Introduction", "Methods", "Results", "Discussion"],
    "heading_bold": true,
    "heading_italic": false,
    "heading_size_pt": 11,
    "subheading_bold": true,
    "subheading_italic": true,
    "subheading_size_pt": 11,
    "body_first_line_indent_cm": 1.27,
    "body_alignment": "justify"
  },

  "back_matter": {
    "sections": [
      "Ethics approval",
      "Data availability",
      "Competing interests",
      "Funding",
      "Authors' contributions",
      "Acknowledgements"
    ],
    "heading_bold": true,
    "heading_italic": true,
    "heading_size_pt": 11
  },

  "citation_style": {
    "inline_format": "vancouver_bracket",
    "bracket_open": "[",
    "bracket_close": "]",
    "separator": ", ",
    "range_separator": "-",
    "examples": ["[1]", "[1, 2]", "[3, 4]", "[12-15]"]
  },

  "references": {
    "section_heading": "References",
    "heading_bold": true,
    "heading_size_pt": 11,
    "list_style": "numbered",
    "entry_format": "vancouver",
    "title_bold": true,
    "journal_italic": true,
    "year_bold": false,
    "volume_bold": true,
    "use_pmid": true,
    "pmid_position": "trailing",
    "entry_example": "Miller L, Campo JV: Depression in Adolescents. N Engl J Med 2021, 385:445-449.",
    "entry_template": "{authors}: {title}. {journal} {year}, {volume}:{pages}."
  },

  "figures": {
    "dpi": 300,
    "width_cm": 14.0,
    "format": ["png", "svg", "pdf"],
    "caption_position": "below",
    "caption_bold_label": true,
    "caption_label_pattern": "Figure {n}.",
    "caption_size_pt": 10,
    "caption_alignment": "left",
    "font_family": "Times New Roman",
    "axis_label_size_pt": 11,
    "tick_label_size_pt": 9,
    "title_size_pt": 12,
    "spine_top_visible": false,
    "spine_right_visible": false,
    "grid_visible": false,
    "color_palette": {
      "primary": "#1f4e79",
      "secondary": "#7d2e2e",
      "accent": "#2e7d32",
      "neutral_dark": "#333333",
      "neutral_light": "#999999",
      "background": "#FFFFFF"
    }
  },

  "tables": {
    "font_family": "Times New Roman",
    "font_size_pt": 9,
    "caption_position": "above",
    "caption_bold_label": true,
    "caption_label_pattern": "Table {n}.",
    "caption_size_pt": 10,
    "caption_alignment": "left",
    "border_style": "horizontal_only",
    "border_top": {"width_pt": 1.5, "color": "#000000"},
    "border_header_bottom": {"width_pt": 0.75, "color": "#000000"},
    "border_bottom": {"width_pt": 1.5, "color": "#000000"},
    "header_bold": true,
    "header_alignment": "center",
    "numeric_alignment": "right",
    "category_alignment": "left",
    "row_padding_cm": 0.08,
    "p_value_format": "italic_P_eq_value",
    "p_value_examples": ["P < 0.001", "P = 0.001", "P = 0.026"],
    "or_format": "OR (95% CI)",
    "footnote_size_pt": 8,
    "footnote_italic": true
  },

  "statistical_reporting": {
    "or_format": "{point} ({lo}-{hi}; P {op} {p})",
    "aor_format": "aOR {point} (95% CI {lo}-{hi}; P {op} {p})",
    "ci_default": 95,
    "n_format": "{n:,}",
    "percent_format": "{pct:.1f}%",
    "trend_phrase": "P for trend = {p}",
    "interaction_phrase": "P for interaction = {p}"
  }
}
