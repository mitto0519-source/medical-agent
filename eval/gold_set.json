      "expected_concepts": ["C_adolescent", "C_korean", "C_topic_diabetes"],
      "min_retrieval_at_5": 0.4,
      "notes": "RAG가 top-5에서 expected_pmids 중 최소 2개 회수해야 함"
    },
    {
      "id": "q_sleep_metabolic",
      "query": "sleep duration metabolic syndrome KNHANES",
      "domain": "behavior×outcome",
      "expected_pmids": [],
      "expected_concepts": ["C_sleep", "C_korean"],
      "min_retrieval_at_5": 0.3,
      "notes": "expected_pmids는 추후 실제 인제스트 결과로 채움"
    },
    {
      "id": "q_obesity_screen_time",
      "query": "screen time and obesity in Korean youth KYRBS",
      "domain": "behavior×outcome",
      "expected_pmids": [],
      "expected_concepts": ["C_physical_activity", "C_adolescent", "C_topic_obesity"],
      "min_retrieval_at_5": 0.3,
      "notes": ""
    },
    {
      "id": "q_diabetes_diet",
      "query": "dietary patterns and type 2 diabetes risk Korean adults",
      "domain": "behavior×disease",
      "expected_pmids": [],
      "expected_concepts": ["C_diet", "C_topic_diabetes", "C_adult"],
      "min_retrieval_at_5": 0.3,
      "notes": ""
    },
    {
      "id": "q_cv_disease_hypertension",
      "query": "hypertension cardiovascular disease prevention cohort",
      "domain": "disease×outcome",
      "expected_pmids": [],
      "expected_concepts": ["C_topic_hypertension", "C_topic_cardiovascular"],
      "min_retrieval_at_5": 0.3,
      "notes": ""
    }
  ],
  "style_targets": [
    {
      "id": "yoosun_baseline",
      "owner_email_hash": "yoosun_seed",
      "expected_avg_sent_len": [16, 28],
      "expected_hedge_ratio": [0.012, 0.045],
      "expected_passive_ratio": [0.20, 0.45]
    }
  ],
  "manuscript_targets": [
    {
      "id": "m_imrad_caffeine",
      "topic": "caffeine and depression",
      "must_have_sections": ["Title", "Abstract", "Introduction", "Methods", "Results", "Discussion", "Conclusion", "References"],
      "min_inline_citations": 5,
      "min_methodology_keywords": ["cross-sectional", "logistic regression", "adjusted", "limitation"],
      "no_overclaim_patterns": ["causes", "definitely", "for the first time", "significantly improves"]
    }
  ]
}
