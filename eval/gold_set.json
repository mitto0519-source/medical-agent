{
  "version": "0.1.0",
  "created": "2026-06-13",
  "purpose": "Quality eval harness — gold queries with expected PMIDs and style fingerprints. self-improvement loop는 이 gold set 위 점수가 오르는 방향으로 학습.",
  "queries": [
    {
      "id": "q_caffeine_depression",
